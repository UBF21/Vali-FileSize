<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;netstandard2.1;net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
        <RootNamespace>ValiFileSize</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <LangVersion>latest</LangVersion>
        <Title>Vali-FileSize</Title>
        <Authors>Felipe Rafael Montenegro Morriberon</Authors>
        <Description>
            Vali-FileSize is a lightweight .NET library for converting and formatting file sizes across all major units: bytes, kilobytes, megabytes, gigabytes, terabytes, petabytes, and exabytes — including full IEC binary prefix support (KiB, MiB, GiB, TiB, PiB, EiB). It provides a clean API with automatic unit detection, human-readable formatting, customizable decimal precision, and cultural number formatting. Includes extension methods on double and long for minimal-boilerplate usage, an IValiFileSize interface for dependency injection, and IntelliSense documentation out of the box.
        </Description>
        <PackageProjectUrl>#</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/UBF21/Vali-FileSize</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>
            Vali-FileSize v1.1.0:
            - Added support for Exabytes (EB) and Exbibytes (EiB) — the full unit range now covers bytes through exabytes.
            - Added full IEC binary prefix support (KiB, MiB, GiB, TiB, PiB, EiB) via useIec flag on GetBestUnit and FormatBestSize.
            - Added FormatBestSize method combining GetBestUnit and FormatSize in a single call.
            - Added extension methods on double and long (ToFormattedSize, FormatBestSize, GetBestUnit) for minimal-boilerplate usage.
            - Added IValiFileSize interface for dependency injection.
            - Expanded target frameworks to netstandard2.0, netstandard2.1, net6.0, net7.0, net8.0, and net9.0.
            - IntelliSense XML documentation now included in the package.
        </PackageReleaseNotes>
        <PackageTags>filesize;converter;formatting;utility</PackageTags>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <Copyright>Copyright © 2025 - FM. All rights reserved.</Copyright>
        <Version>1.1.0</Version>
        <PackageIcon>logo-vali-filesize.png</PackageIcon>
        <PackageId>Vali-FileSize</PackageId>
        <Product>Vali-FileSize</Product>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="logo-vali-filesize.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>
</Project>
